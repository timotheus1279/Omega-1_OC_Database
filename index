    } =
        await supabaseClient.auth.getSession();


    if (
        session &&
        session.user
    ) {

        localUserId =
            session.user.id;

        return true;

    }


    const {
        data,
        error
    } =
        await supabaseClient.auth.signInAnonymously();


    if (error) {

        console.error(
            "Supabase anonymous login failed:",
            error
        );

        alert(
            "SCIPNET DATABASE ERROR\n\n" +
            "Anonymous authentication could not be established.\n\n" +
            error.message
        );

        return false;

    }


    if (
        !data ||
        !data.user
    ) {

        alert(
            "SCIPNET DATABASE ERROR\n\n" +
            "No Supabase user was returned."
        );

        return false;

    }


    localUserId =
        data.user.id;


    return true;

}


