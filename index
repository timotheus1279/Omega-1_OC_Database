/* =========================================================
   SKIN ZOOM
   ========================================================= */

const skinZoomOverlay =
    document.getElementById(
        "skin-zoom-overlay"
    );


const skinZoomImage =
    document.getElementById(
        "skin-zoom-image"
    );


const skinZoomTitle =
    document.getElementById(
        "skin-zoom-title"
    );


const zoomLevel =
    document.getElementById(
        "zoom-level"
    );


let currentZoom =
    1;


let currentZoomSide =
    "front";


function openSkinZoom(side) {

    const dossier =
        getCurrentDossier();


    if (
        !dossier
    )
        return;


    let imageSource =
        "";


    if (
        side === "back"
    ) {

        imageSource =
            dossier.skinBack || "";

    } else {

        imageSource =
            dossier.skinFront ||
            dossier.skin ||
            "";

    }


    if (
        !imageSource
    ) {

        return;

    }


    currentZoomSide =
        side;


    currentZoom =
        1;


    skinZoomImage.src =
        imageSource;


    skinZoomTitle.textContent =
        side === "back"
            ? "PERSONNEL SKIN // BACK"
            : "PERSONNEL SKIN // FRONT";


    updateZoomDisplay();


    skinZoomOverlay.classList.add(
        "visible"
    );

}


function closeSkinZoom() {

    skinZoomOverlay.classList.remove(
        "visible"
    );


    currentZoom =
        1;


    skinZoomImage.style.transform =
        "scale(1)";

}


function handleZoomBackgroundClick(event) {

    if (
        event.target ===
        skinZoomOverlay
    ) {

        closeSkinZoom();

    }

}


function changeZoom(amount) {

    currentZoom +=
        amount;


    currentZoom =
        Math.max(
            0.5,
            Math.min(
                3,
                currentZoom
            )
        );


    updateZoomDisplay();

}


function resetZoom() {

    currentZoom =
        1;


    updateZoomDisplay();

}


function updateZoomDisplay() {

    skinZoomImage.style.transform =
        "scale(" +
        currentZoom +
        ")";


    zoomLevel.textContent =
        Math.round(
            currentZoom * 100
        ) +
        "%";

}


/* =========================================================
   MOUSE WHEEL ZOOM
   ========================================================= */

const skinZoomView =
    document.getElementById(
        "skin-zoom-view"
    );


if (
    skinZoomView
) {

    skinZoomView.addEventListener(
        "wheel",
        function(event) {

            event.preventDefault();


            if (
                event.deltaY < 0
            ) {

                changeZoom(
                    0.1
                );

            } else {

                changeZoom(
                    -0.1
                );

            }

        },
        {
            passive: false
        }
    );

}


/* =========================================================
   INITIALIZATION
   ========================================================= */

async function initializeSCIPNET() {

    /*
       First establish the Supabase connection
       and load the shared online database.
    */

    const databaseReady =
        await initializeDatabase();


    if (
        !databaseReady
    ) {

        return;

    }


    /*
       Select the first available dossier.
    */

    if (
        dossiers.length > 0
    ) {

        currentDossierId =
            dossiers[0].id;

    }


    /*
       Render the shared dossier list.
    */

    renderDossierList();


    /*
       Load the selected dossier.
    */

    if (
        currentDossierId
    ) {

        loadDossier();

    }


    updateStatusColor();

    updateEditorPermissions();


    /*
       Only start the boot sequence after
       the online database is ready.
    */

    startBootSequence();

}


initializeSCIPNET();


