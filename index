<!DOCTYPE html>
<html lang="de">
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>

<head>

<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>SCIPNET // SITE-416</title>

<style>

/* =========================================================
   GLOBAL
   ========================================================= */

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html,
body {
    width: 100%;
    height: 100%;
    overflow: hidden;
    background: #050505;
    color: #ffffff;
    font-family: Arial, Helvetica, sans-serif;
}

button,
input,
select,
textarea {
    font-family: inherit;
}


/* =========================================================
   BOOT SCREEN
   ========================================================= */

#boot-screen {
    position: fixed;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #050505;
    z-index: 9999;
    transition:
        opacity 1.2s ease,
        visibility 1.2s ease;
}

#boot-screen.hidden {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
}

.boot-container {
    width: 560px;
    max-width: 90%;
    font-family: "Courier New", monospace;
}

.boot-title {
    font-size: 44px;
    font-weight: 600;
    letter-spacing: 5px;
    margin-bottom: 8px;
}

.boot-subtitle {
    color: rgba(255,255,255,0.45);
    font-size: 12px;
    letter-spacing: 3px;
    margin-bottom: 35px;
}

#boot-log {
    min-height: 180px;
    font-size: 13px;
    line-height: 1.8;
    color: rgba(255,255,255,0.65);
}

.boot-line {
    animation:
        bootLine
        0.25s
        ease
        forwards;
}

@keyframes bootLine {

    from {
        opacity: 0;
        transform: translateX(-5px);
    }

    to {
        opacity: 1;
        transform: translateX(0);
    }

}

.progress-container {
    width: 100%;
    height: 2px;
    background: rgba(255,255,255,0.08);
    margin-top: 20px;
    overflow: hidden;
}

#progress-bar {
    width: 0%;
    height: 100%;
    background: white;
    transition: width 0.5s ease;
}

#boot-status {
    margin-top: 14px;
    font-family: "Courier New", monospace;
    font-size: 11px;
    letter-spacing: 2px;
    color: rgba(255,255,255,0.45);
}


/* =========================================================
   MAIN
   ========================================================= */

#scipnet {
    width: 100%;
    height: 100%;
    opacity: 0;
    transform: scale(1.015);
    visibility: hidden;
    transition:
        opacity 1.3s ease,
        transform 1.5s cubic-bezier(.2,.8,.2,1),
        visibility 0s linear 1.3s;
}

#scipnet.visible {
    opacity: 1;
    transform: scale(1);
    visibility: visible;
    transition:
        opacity 1.3s ease,
        transform 1.5s cubic-bezier(.2,.8,.2,1),
        visibility 0s;
}


/* =========================================================
   ACCESS SCREEN
   ========================================================= */

#access-screen {
    position: fixed;
    inset: 0;
    z-index: 9000;

    display: flex;
    align-items: center;
    justify-content: center;

    background:
        radial-gradient(
            circle at center,
            rgba(255,255,255,0.025),
            rgba(0,0,0,0.98) 65%
        );

    opacity: 0;
    visibility: hidden;
    pointer-events: none;

    transition:
        opacity .7s ease,
        visibility .7s ease;
}

#access-screen.visible {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
}

.access-box {
    width: 510px;
    max-width: calc(100% - 40px);

    padding: 30px;

    border:
        1px solid rgba(255,255,255,0.15);

    background:
        rgba(8,8,8,0.92);

    backdrop-filter:
        blur(22px);

    box-shadow:
        0 30px 100px rgba(0,0,0,0.75);

    transform:
        translateY(12px)
        scale(.98);

    opacity: 0;

    transition:
        transform .7s cubic-bezier(.2,.8,.2,1),
        opacity .7s ease;
}

#access-screen.visible .access-box {
    transform:
        translateY(0)
        scale(1);

    opacity: 1;
}

.access-label {
    font-family: "Courier New", monospace;
    font-size: 9px;
    letter-spacing: 2px;
    color: rgba(255,255,255,0.32);
    margin-bottom: 10px;
}

.access-title {
    font-size: 22px;
    letter-spacing: 2px;
    font-weight: 500;
    margin-bottom: 17px;
}

.access-text {
    color: rgba(255,255,255,0.48);
    font-size: 13px;
    line-height: 1.7;
    margin-bottom: 25px;
}

.access-warning {
    padding: 10px 12px;
    border-left: 2px solid rgba(255,255,255,0.45);
    background: rgba(255,255,255,0.025);
    color: rgba(255,255,255,0.38);
    font-family: "Courier New", monospace;
    font-size: 9px;
    line-height: 1.6;
    letter-spacing: .6px;
    margin-bottom: 24px;
}

.access-actions {
    display: flex;
    gap: 9px;
}

.access-button {
    flex: 1;
    height: 43px;

    border:
        1px solid rgba(255,255,255,0.14);

    background:
        rgba(255,255,255,0.035);

    color:
        rgba(255,255,255,0.70);

    font-family:
        "Courier New",
        monospace;

    font-size:
        10px;

    letter-spacing:
        1px;

    cursor:
        pointer;

    transition:
        background .2s ease,
        border-color .2s ease,
        transform .2s ease;
}

.access-button:hover {
    background:
        rgba(255,255,255,0.08);

    border-color:
        rgba(255,255,255,0.25);

    transform:
        translateY(-1px);

    color:
        white;
}

.access-button.primary {
    background:
        rgba(255,255,255,0.09);

    border-color:
        rgba(255,255,255,0.23);

    color:
        white;
}

.access-button.exit {
    color:
        rgba(255,255,255,0.42);
}


/* =========================================================
   TERMINATED SCREEN
   ========================================================= */

#terminated-screen {
    position: fixed;
    inset: 0;
    z-index: 10000;

    display: flex;
    align-items: center;
    justify-content: center;

    background: #030303;

    opacity: 0;
    visibility: hidden;
    pointer-events: none;

    transition:
        opacity .7s ease,
        visibility .7s ease;
}

#terminated-screen.visible {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
}

.terminated-content {
    text-align: center;
    font-family: "Courier New", monospace;
}

.terminated-symbol {
    font-size: 42px;
    color: rgba(255,255,255,0.65);
    margin-bottom: 18px;
}

.terminated-title {
    font-size: 17px;
    letter-spacing: 3px;
    color: rgba(255,255,255,0.78);
    margin-bottom: 10px;
}

.terminated-subtitle {
    font-size: 9px;
    letter-spacing: 1.5px;
    color: rgba(255,255,255,0.27);
}


/* =========================================================
   EXIT CONFIRMATION
   ========================================================= */

#exit-confirm {
    position: fixed;
    inset: 0;
    z-index: 9500;

    display: flex;
    align-items: center;
    justify-content: center;

    background: rgba(0,0,0,0.70);
    backdrop-filter: blur(8px);

    opacity: 0;
    visibility: hidden;
    pointer-events: none;

    transition:
        opacity .3s ease,
        visibility .3s ease;
}

#exit-confirm.visible {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
}

.exit-box {
    width: 390px;
    max-width: calc(100% - 40px);

    padding: 25px;

    border:
        1px solid rgba(255,255,255,0.15);

    background:
        rgba(8,8,8,0.96);

    box-shadow:
        0 30px 90px rgba(0,0,0,.7);

    transform:
        scale(.96);

    transition:
        transform .3s ease;
}

#exit-confirm.visible .exit-box {
    transform:
        scale(1);
}

.exit-label {
    font-family: "Courier New", monospace;
    font-size: 9px;
    letter-spacing: 2px;
    color: rgba(255,255,255,.30);
    margin-bottom: 9px;
}

.exit-title {
    font-size: 18px;
    letter-spacing: 1.5px;
    margin-bottom: 12px;
}

.exit-text {
    color: rgba(255,255,255,.43);
    font-size: 12px;
    line-height: 1.6;
    margin-bottom: 22px;
}

.exit-actions {
    display: flex;
    gap: 8px;
}

.exit-action {
    flex: 1;
    height: 39px;
    border: 1px solid rgba(255,255,255,.12);
    background: rgba(255,255,255,.035);
    color: rgba(255,255,255,.65);
    font-family: "Courier New", monospace;
    font-size: 9px;
    letter-spacing: 1px;
    cursor: pointer;
}

.exit-action:hover {
    background: rgba(255,255,255,.08);
    color: white;
}

.exit-action.confirm {
    color: rgba(255,255,255,.85);
}


/* =========================================================
   HEADER
   ========================================================= */

header {
    position: relative;
    height: 68px;
    display: flex;
    align-items: center;
    padding: 0 32px;
    background: rgba(255,255,255,0.025);
    border-bottom: 1px solid rgba(255,255,255,0.12);
    z-index: 50;
    backdrop-filter: blur(14px);
}

.system-name {
    font-size: 19px;
    letter-spacing: 3px;
    font-weight: 500;
}

.site-number {
    margin-left: 35px;
    font-family: "Courier New", monospace;
    font-size: 12px;
    color: rgba(255,255,255,0.42);
    letter-spacing: 2px;
}

.status {
    margin-left: auto;
    font-family: "Courier New", monospace;
    font-size: 11px;
    letter-spacing: 1.5px;
    color: rgba(255,255,255,0.55);
}

.header-exit {
    margin-left: 20px;

    height: 30px;
    padding: 0 11px;

    border:
        1px solid rgba(255,255,255,0.11);

    background:
        rgba(255,255,255,0.025);

    color:
        rgba(255,255,255,0.38);

    font-family:
        "Courier New",
        monospace;

    font-size:
        8px;

    letter-spacing:
        1.2px;

    cursor:
        pointer;

    transition:
        background .2s ease,
        border-color .2s ease,
        color .2s ease;
}

.header-exit:hover {
    background:
        rgba(255,255,255,0.07);

    border-color:
        rgba(255,255,255,0.22);

    color:
        white;
}


/* =========================================================
   MAIN AREA
   ========================================================= */

main {
    position: relative;
    width: 100%;
    height: calc(100% - 68px);
    overflow: hidden;
    background: #050505;
}


/* =========================================================
   GRID
   ========================================================= */

.grid {
    position: absolute;
    inset: 0;
    z-index: 1;

    background-image:

        linear-gradient(
            rgba(255,255,255,0.035) 1px,
            transparent 1px
        ),

        linear-gradient(
            90deg,
            rgba(255,255,255,0.035) 1px,
            transparent 1px
        ),

        radial-gradient(
            circle,
            rgba(255,255,255,0.20) 1px,
            transparent 1.3px
        );

    background-size:
        70px 70px,
        70px 70px,
        70px 70px;

    pointer-events: none;
    opacity: 0.75;
}


/* =========================================================
   SCP BACKGROUND LOGO
   ========================================================= */

.logo-background {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 720px;
    height: 720px;

    transform:
        translate(-50%, -50%);

    object-fit: contain;
    z-index: 2;

    opacity: 0.045;

    filter:
        grayscale(1)
        brightness(1.8)
        blur(4px);

    pointer-events: none;
    user-select: none;

    animation:
        logoFloat
        14s
        ease-in-out
        infinite
        alternate;
}

@keyframes logoFloat {

    from {
        transform:
            translate(-50%, -50%)
            scale(0.98);
    }

    to {
        transform:
            translate(-50%, -50%)
            scale(1.03);
    }

}


/* =========================================================
   VIGNETTE
   ========================================================= */

.vignette {
    position: absolute;
    inset: 0;
    z-index: 3;
    pointer-events: none;

    background:
        radial-gradient(
            ellipse at center,
            transparent 20%,
            rgba(0,0,0,0.25) 60%,
            rgba(0,0,0,0.75) 100%
        );
}


/* =========================================================
   DATABASE WORKSPACE
   ========================================================= */

.database-workspace {
    position: absolute;

    left: 30px;
    right: 30px;

    top: 25px;
    bottom: 42px;

    z-index: 20;

    display: grid;

    grid-template-columns:
        245px
        minmax(0, 1fr)
        245px;

    gap: 14px;

    min-height: 0;
}


/* =========================================================
   GENERIC PANEL
   ========================================================= */

.database-panel {
    background: rgba(6,6,6,0.78);

    border:
        1px solid rgba(255,255,255,0.13);

    backdrop-filter:
        blur(18px);

    box-shadow:
        0 25px 80px rgba(0,0,0,0.45);

    min-height: 0;
}


/* =========================================================
   LEFT DOSSIER STORAGE
   ========================================================= */

.dossier-storage {
    display: flex;
    flex-direction: column;
    overflow: hidden;

    background:
        linear-gradient(
            180deg,
            rgba(255,255,255,0.025),
            rgba(255,255,255,0.008)
        );

    position: relative;
}

.dossier-storage::after {
    content: "";

    position: absolute;

    top: 0;
    right: 0;
    bottom: 0;

    width: 1px;

    background:
        linear-gradient(
            to bottom,
            transparent,
            rgba(255,255,255,0.10),
            transparent
        );

    pointer-events: none;
}

.storage-header {
    padding: 18px 17px 16px;

    border-bottom:
        1px solid rgba(255,255,255,0.10);

    background:
        rgba(255,255,255,0.018);
}

.storage-label {
    font-family: "Courier New", monospace;
    font-size: 9px;
    letter-spacing: 2px;
    color: rgba(255,255,255,0.32);
    margin-bottom: 8px;
}

.storage-title {
    font-size: 18px;
    letter-spacing: 1.5px;
    font-weight: 500;
    position: relative;
    padding-left: 11px;
}

.storage-title::before {
    content: "";
    position: absolute;
    left: 0;
    top: 3px;
    bottom: 3px;
    width: 2px;
    background: rgba(255,255,255,0.75);
    box-shadow: 0 0 8px rgba(255,255,255,0.20);
}

.new-dossier-button {
    width: 100%;
    height: 40px;
    margin-top: 16px;

    border: 1px solid rgba(255,255,255,0.14);

    background:
        linear-gradient(
            90deg,
            rgba(255,255,255,0.055),
            rgba(255,255,255,0.025)
        );

    color: rgba(255,255,255,0.78);

    font-family: "Courier New", monospace;
    font-size: 10px;
    letter-spacing: 1.4px;
    cursor: pointer;

    transition:
        background .22s ease,
        border-color .22s ease,
        transform .22s ease,
        box-shadow .22s ease;

    position: relative;
    overflow: hidden;
}

.new-dossier-button::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 2px;
    background: rgba(255,255,255,0.75);
    transform: scaleY(0);
    transition: transform .22s ease;
}

.new-dossier-button:hover {
    background: rgba(255,255,255,0.075);
    border-color: rgba(255,255,255,0.28);
    transform: translateY(-1px);
    box-shadow: 0 8px 25px rgba(0,0,0,0.20);
}

.new-dossier-button:hover::before {
    transform: scaleY(1);
}

.storage-search {
    padding: 12px 12px 10px;
    border-bottom: 1px solid rgba(255,255,255,0.07);
    position: relative;
}

.storage-search::before {
    content: "⌕";
    position: absolute;
    left: 22px;
    top: 21px;
    color: rgba(255,255,255,0.25);
    font-size: 14px;
    pointer-events: none;
    z-index: 2;
}

.storage-search input {
    width: 100%;
    height: 36px;
    padding: 0 10px 0 31px;

    background: rgba(255,255,255,0.025);
    border: 1px solid rgba(255,255,255,0.08);
    outline: none;

    color: white;

    font-family: "Courier New", monospace;
    font-size: 10px;
    letter-spacing: .5px;

    transition:
        border-color .2s ease,
        background .2s ease,
        box-shadow .2s ease;
}

.storage-search input:focus {
    border-color: rgba(255,255,255,0.22);
    background: rgba(255,255,255,0.045);
    box-shadow: 0 0 18px rgba(255,255,255,0.035);
}

.storage-search input::placeholder {
    color: rgba(255,255,255,0.22);
}

.dossier-list {
    flex: 1;
    overflow-y: auto;
    padding: 9px 8px 8px;
}

.dossier-list::-webkit-scrollbar {
    width: 3px;
}

.dossier-list::-webkit-scrollbar-track {
    background: transparent;
}

.dossier-list::-webkit-scrollbar-thumb {
    background: rgba(255,255,255,0.17);
}

.dossier-card {
    position: relative;
    padding: 13px 12px 12px 14px;
    margin-bottom: 7px;

    border: 1px solid rgba(255,255,255,0.055);
    background: rgba(255,255,255,0.018);

    cursor: pointer;
    overflow: hidden;

    transition:
        background .20s ease,
        border-color .20s ease,
        transform .20s ease,
        box-shadow .20s ease;
}

.dossier-card::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 2px;

    background:
        var(--status-color, rgba(255,255,255,0.5));

    box-shadow:
        0 0 10px var(--status-color, transparent);

    opacity: .45;

    transition:
        opacity .20s ease,
        width .20s ease;
}

.dossier-card::after {
    content: "";
    position: absolute;
    right: -25px;
    top: -25px;
    width: 70px;
    height: 70px;
    border-radius: 50%;

    background: var(--status-color, transparent);
    opacity: .025;
    filter: blur(16px);

    pointer-events: none;
}

.dossier-card:hover {
    background: rgba(255,255,255,0.045);
    border-color: rgba(255,255,255,0.13);
    transform: translateX(2px);
    box-shadow: 0 8px 25px rgba(0,0,0,0.20);
}

.dossier-card:hover::before {
    opacity: .9;
    width: 3px;
}

.dossier-card.selected {
    background:
        linear-gradient(
            90deg,
            rgba(255,255,255,0.075),
            rgba(255,255,255,0.035)
        );

    border-color: rgba(255,255,255,0.20);

    box-shadow:
        inset 0 0 25px rgba(255,255,255,0.018),
        0 8px 25px rgba(0,0,0,0.18);
}

.dossier-card.selected::before {
    opacity: 1;
    width: 3px;
}

.card-id {
    font-family: "Courier New", monospace;
    font-size: 8px;
    color: rgba(255,255,255,0.27);
    letter-spacing: 1.5px;
    margin-bottom: 6px;
}

.card-name {
    font-size: 13px;
    letter-spacing: .6px;
    margin-bottom: 8px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.card-status {
    font-family: "Courier New", monospace;
    font-size: 8px;
    letter-spacing: 1.2px;
    transition: color .25s ease, text-shadow .25s ease;
}

.card-ownership {
    margin-top: 7px;
    padding-top: 6px;

    border-top:
        1px solid rgba(255,255,255,0.045);

    font-family: "Courier New", monospace;
    font-size: 7px;
    letter-spacing: .8px;
    color: rgba(255,255,255,0.22);
}


/* =========================================================
   STORAGE STATUS GLOW
   ========================================================= */

.dossier-card.status-active {
    --status-color: #79ff9a;
}

.dossier-card.status-retired {
    --status-color: #aaaaaa;
}

.dossier-card.status-inactive {
    --status-color: #72aaff;
}

.dossier-card.status-suspended {
    --status-color: #ffe078;
}

.dossier-card.status-mia {
    --status-color: #ffad68;
}

.dossier-card.status-kia {
    --status-color: #ff6464;
}

.dossier-card.status-transferred {
    --status-color: #bf8cff;
}

.dossier-card.status-unknown {
    --status-color: #888888;
}

.dossier-card .card-status {
    color: var(--status-color);
    text-shadow: 0 0 8px var(--status-color);
}


/* =========================================================
   CENTER DOSSIER
   ========================================================= */

.personnel-dossier {
    display: flex;
    flex-direction: column;
    min-width: 0;
    min-height: 0;
    overflow: hidden;

    background: rgba(7,7,7,0.80);

    border: 1px solid rgba(255,255,255,0.14);

    backdrop-filter: blur(20px);

    box-shadow: 0 30px 100px rgba(0,0,0,0.55);

    animation:
        dossierAppear
        .9s
        cubic-bezier(.2,.8,.2,1)
        both;
}

@keyframes dossierAppear {

    from {
        opacity: 0;
        transform: translateY(10px) scale(.985);
    }

    to {
        opacity: 1;
        transform: translateY(0) scale(1);
    }

}

.dossier-header {
    min-height: 78px;

    display: flex;
    align-items: center;
    justify-content: space-between;

    padding: 0 24px;

    border-bottom:
        1px solid rgba(255,255,255,0.10);

    background:
        rgba(255,255,255,0.025);
}

.dossier-label {
    font-family: "Courier New", monospace;
    font-size: 10px;
    letter-spacing: 2px;
    color: rgba(255,255,255,0.35);
    margin-bottom: 7px;
}

.dossier-title {
    font-size: 20px;
    letter-spacing: 3px;
    font-weight: 500;
}

.dossier-id {
    font-family: "Courier New", monospace;
    font-size: 11px;
    letter-spacing: 2px;
    color: rgba(255,255,255,0.42);
}

.editor-state {
    display: flex;
    align-items: center;
    gap: 7px;

    margin-left: 20px;

    font-family: "Courier New", monospace;
    font-size: 9px;
    letter-spacing: 1px;
    color: rgba(255,255,255,0.35);
}

.editor-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: rgba(255,255,255,0.3);
}

.editor-state.unlocked {
    color: rgba(255,255,255,0.75);
}

.editor-state.unlocked .editor-dot {
    background: #ffffff;
    box-shadow: 0 0 8px rgba(255,255,255,0.4);
}


/* =========================================================
   DOSSIER CONTENT
   ========================================================= */

.dossier-content {
    flex: 1;
    min-height: 0;
    overflow-y: auto;
    padding: 22px 24px 28px;
}

.dossier-content::-webkit-scrollbar {
    width: 5px;
}

.dossier-content::-webkit-scrollbar-track {
    background: rgba(255,255,255,0.02);
}

.dossier-content::-webkit-scrollbar-thumb {
    background: rgba(255,255,255,0.18);
}


/* =========================================================
   FIELD GRID
   ========================================================= */

.biodata-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0,1fr));
    gap: 17px 20px;
}

.field {
    display: flex;
    flex-direction: column;
    gap: 8px;
}

.field label {
    font-family: "Courier New", monospace;
    font-size: 10px;
    letter-spacing: 1.5px;
    color: rgba(255,255,255,0.40);
}

.field input,
.field select {
    width: 100%;
    height: 40px;
    padding: 0 11px;

    background: rgba(255,255,255,0.025);

    border:
        1px solid rgba(255,255,255,0.09);

    outline: none;

    color: white;

    font-family: "Courier New", monospace;
    font-size: 12px;

    transition:
        border-color .2s ease,
        background .2s ease;
}

.field input::placeholder {
    color: rgba(255,255,255,0.20);
}

.field input:focus,
.field select:focus {
    border-color: rgba(255,255,255,0.28);
    background: rgba(255,255,255,0.045);
}

.field select {
    appearance: none;
    cursor: pointer;
}

.field select option {
    background: #111111;
    color: white;
}


/* =========================================================
   STATUS
   ========================================================= */

.status-select.status-active {
    color: #8cffaa;
    border-color: rgba(100,255,140,0.25);
    background: rgba(60,180,90,0.06);
    box-shadow: 0 0 12px rgba(80,255,120,0.05);
}

.status-select.status-retired {
    color: #aaaaaa;
    border-color: rgba(180,180,180,0.22);
}

.status-select.status-inactive {
    color: #82b9ff;
    border-color: rgba(100,160,255,0.25);
    box-shadow: 0 0 12px rgba(100,160,255,0.05);
}

.status-select.status-suspended {
    color: #ffe082;
    border-color: rgba(255,210,80,0.25);
    box-shadow: 0 0 12px rgba(255,210,80,0.05);
}

.status-select.status-mia {
    color: #ffb16b;
    border-color: rgba(255,150,70,0.25);
    box-shadow: 0 0 12px rgba(255,150,70,0.05);
}

.status-select.status-kia {
    color: #ff6e6e;
    border-color: rgba(255,70,70,0.28);
    box-shadow: 0 0 12px rgba(255,70,70,0.06);
}

.status-select.status-transferred {
    color: #c79cff;
    border-color: rgba(170,110,255,0.25);
    box-shadow: 0 0 12px rgba(170,110,255,0.05);
}

.status-select.status-unknown {
    color: #888888;
    border-color: rgba(130,130,130,0.18);
}


/* =========================================================
   SPECIALITIES
   ========================================================= */

.speciality-field {
    grid-column: 1 / -1;
}

.speciality-dropdown {
    position: relative;
    width: 100%;
}

.speciality-button {
    width: 100%;
    height: 40px;
    padding: 0 11px;

    display: flex;
    align-items: center;
    justify-content: space-between;

    background: rgba(255,255,255,0.025);

    border:
        1px solid rgba(255,255,255,0.09);

    color: rgba(255,255,255,0.60);

    font-family: "Courier New", monospace;
    font-size: 12px;

    cursor: pointer;

    transition:
        background .2s ease,
        border-color .2s ease;
}

.speciality-button:hover {
    background: rgba(255,255,255,0.045);
    border-color: rgba(255,255,255,0.18);
}

.speciality-arrow {
    font-size: 14px;
    color: rgba(255,255,255,0.4);
    transition: transform .2s ease;
}

.speciality-dropdown.open .speciality-arrow {
    transform: rotate(180deg);
}

.speciality-menu {
    position: absolute;
    left: 0;
    right: 0;
    top: calc(100% + 5px);

    background: rgba(10,10,10,0.99);

    border:
        1px solid rgba(255,255,255,0.12);

    padding: 5px;

    z-index: 100;

    opacity: 0;
    visibility: hidden;

    transform: translateY(-5px);

    transition:
        opacity .18s ease,
        transform .18s ease,
        visibility .18s ease;
}

.speciality-menu.open {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
}

.speciality-option {
    height: 43px;

    display: flex;
    align-items: center;
    gap: 11px;

    padding: 0 10px;

    cursor: pointer;

    font-family: "Courier New", monospace;
    font-size: 13px;
    font-weight: 500;

    color: rgba(255,255,255,0.65);

    transition:
        background .15s ease,
        color .15s ease,
        padding-left .15s ease;
}

.speciality-option:hover {
    background: rgba(255,255,255,0.06);
    color: white;
    padding-left: 13px;
}

.speciality-option input {
    appearance: none;

    width: 13px;
    height: 13px;

    flex-shrink: 0;

    border:
        1px solid rgba(255,255,255,0.25);

    background: transparent;

    cursor: pointer;
    position: relative;
}

.speciality-option input:checked {
    background: rgba(255,255,255,0.85);
    border-color: white;
}

.speciality-option input:checked::after {
    content: "";

    position: absolute;

    width: 5px;
    height: 5px;

    background: #111;

    left: 3px;
    top: 3px;
}

.speciality-limit {
    padding: 8px 10px;

    font-family: "Courier New", monospace;
    font-size: 9px;

    color: rgba(255,255,255,0.30);

    border-top:
        1px solid rgba(255,255,255,0.06);

    margin-top: 4px;
}

.selected-specialities {
    display: flex;
    gap: 6px;
    margin-top: 8px;
    flex-wrap: wrap;
}

.speciality-tag {
    padding: 5px 8px;

    border:
        1px solid rgba(255,255,255,0.13);

    background:
        rgba(255,255,255,0.04);

    font-family: "Courier New", monospace;
    font-size: 9px;
    letter-spacing: .7px;

    color: rgba(255,255,255,0.70);
}


/* =========================================================
   HISTORY / NOTES
   ========================================================= */

.records-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 18px;

    margin-top: 22px;
    padding-top: 20px;

    border-top:
        1px solid rgba(255,255,255,0.08);

    align-items: stretch;
}

.record-box {
    border:
        1px solid rgba(255,255,255,0.10);

    background:
        rgba(255,255,255,0.018);

    min-height: 300px;

    display:
        flex;

    flex-direction:
        column;

    overflow: hidden;
}

.record-header {
    display:
        flex;

    align-items:
        center;

    justify-content:
        space-between;

    padding:
        13px 15px;

    border-bottom:
        1px solid rgba(255,255,255,0.08);

    flex-shrink: 0;
}

.record-title {
    font-family:
        "Courier New",
        monospace;

    font-size:
        11px;

    letter-spacing:
        2px;

    color:
        rgba(255,255,255,0.55);
}

.record-add {
    border:
        none;

    background:
        transparent;

    color:
        rgba(255,255,255,0.45);

    font-family:
        "Courier New",
        monospace;

    font-size:
        10px;

    cursor:
        pointer;
}

.record-add:hover {
    color: white;
}

.record-content {
    flex: 1;
    min-height: 0;

    padding: 15px;

    display: flex;
    flex-direction: column;
}

.record-heading {
    width: 100%;
    height: 36px;

    margin-bottom: 10px;
    padding: 0 9px;

    background:
        rgba(255,255,255,0.025);

    border:
        1px solid rgba(255,255,255,0.08);

    outline: none;

    color: white;

    font-family:
        Arial,
        Helvetica,
        sans-serif;

    font-size: 14px;
    font-weight: 600;

    flex-shrink: 0;
}

.record-heading::placeholder {
    color:
        rgba(255,255,255,0.20);
}


/* =========================================================
   NOTES — FULL HEIGHT TEXTBOX
   ========================================================= */

.record-text {
    width: 100%;

    flex: 1;

    min-height: 0;

    resize: auto;

    padding: 10px;

    background:
        rgba(255,255,255,0.018);

    border:
        1px solid rgba(255,255,255,0.07);

    outline: none;

    color:
        rgba(255,255,255,0.78);

    font-family:
        Arial,
        Helvetica,
        sans-serif;

    font-size: 13px;

    line-height: 1.65;
}

.record-text:focus,
.record-heading:focus {
    border-color:
        rgba(255,255,255,0.20);

    background:
        rgba(255,255,255,0.035);
}


/* =========================================================
   HISTORY RICH TEXT EDITOR
   ========================================================= */

.history-editor-content {
    padding: 13px 15px 15px;
}

.history-toolbar {
    height: 36px;

    display: flex;
    align-items: center;
    gap: 3px;

    margin-bottom: 8px;
    padding: 3px;

    border:
        1px solid rgba(255,255,255,0.07);

    background:
        rgba(255,255,255,0.018);

    overflow: hidden;

    flex-shrink: 0;
}

.history-toolbar button {
    height: 28px;
    min-width: 29px;
    padding: 0 7px;

    border:
        1px solid transparent;

    background:
        transparent;

    color:
        rgba(255,255,255,0.48);

    font-family:
        "Courier New",
        monospace;

    font-size: 9px;

    cursor: pointer;

    transition:
        background .16s ease,
        color .16s ease,
        border-color .16s ease;
}

.history-toolbar button:hover {
    background:
        rgba(255,255,255,0.07);

    border-color:
        rgba(255,255,255,0.10);

    color: white;
}

.history-toolbar select {
    height: 28px;

    padding: 0 6px;

    border:
        1px solid transparent;

    outline: none;

    background:
        transparent;

    color:
        rgba(255,255,255,0.48);

    font-family:
        "Courier New",
        monospace;

    font-size: 8px;

    cursor: pointer;
}

.history-toolbar select:hover,
.history-toolbar select:focus {
    background:
        rgba(255,255,255,0.07);

    border-color:
        rgba(255,255,255,0.10);

    color: white;
}

.history-toolbar select option {
    background: #111;
    color: white;
}

.toolbar-divider {
    width: 1px;
    height: 17px;

    background:
        rgba(255,255,255,0.08);

    margin: 0 4px;
}

.history-editor {
    width: 100%;

    flex: 1;

    min-height: 0;

    overflow-y: auto;

    padding: 10px;

    background:
        rgba(255,255,255,0.018);

    border:
        1px solid rgba(255,255,255,0.07);

    outline: none;

    color:
        rgba(255,255,255,0.80);

    font-family:
        Arial,
        Helvetica,
        sans-serif;

    font-size: 13px;

    line-height: 1.65;

    transition:
        border-color .2s ease,
        background .2s ease,
        box-shadow .2s ease;
}

.history-editor:focus {
    border-color:
        rgba(255,255,255,0.20);

    background:
        rgba(255,255,255,0.035);

    box-shadow:
        inset 0 0 20px rgba(255,255,255,0.012);
}

.history-editor:empty::before {
    content:
        attr(data-placeholder);

    color:
        rgba(255,255,255,0.20);

    pointer-events:
        none;
}

.history-editor::-webkit-scrollbar {
    width: 4px;
}

.history-editor::-webkit-scrollbar-track {
    background:
        rgba(255,255,255,0.02);
}

.history-editor::-webkit-scrollbar-thumb {
    background:
        rgba(255,255,255,0.16);
}

.history-editor ul,
.history-editor ol {
    padding-left: 24px;
    margin: 7px 0;
}

.history-editor p {
    margin: 0 0 7px;
}

.history-editor b,
.history-editor strong {
    color: #ffffff;
    font-weight: 700;
}

.history-editor u {
    text-underline-offset: 2px;
}


/* =========================================================
   SKIN SECTION
   ========================================================= */

.skin-section {
    margin-top: 22px;

    padding-top: 20px;

    border-top:
        1px solid rgba(255,255,255,0.08);

    display: grid;

    grid-template-columns:
        355px
        1fr;

    gap: 18px;

    align-items: start;
}


/* TWO SKIN PREVIEWS */

.skin-previews {
    display: grid;

    grid-template-columns:
        1fr
        1fr;

    gap: 12px;
}

.skin-card {
    min-width: 0;
}

.skin-card-label {
    font-family:
        "Courier New",
        monospace;

    font-size:
        9px;

    letter-spacing:
        1.5px;

    color:
        rgba(255,255,255,0.35);

    margin-bottom:
        7px;
}


/* SQUARE SKIN */

.skin-preview {
    width: 100%;
    aspect-ratio: 1 / 1;

    border:
        1px solid rgba(255,255,255,0.12);

    background:
        rgba(255,255,255,0.025);

    display:
        flex;

    align-items:
        center;

    justify-content:
        center;

    overflow:
        hidden;

    position:
        relative;

    cursor:
        zoom-in;

    transition:
        border-color .2s ease,
        box-shadow .2s ease,
        transform .2s ease;
}

.skin-preview:hover {
    border-color:
        rgba(255,255,255,0.25);

    box-shadow:
        0 10px 30px rgba(0,0,0,0.30);
}

.skin-preview::before {
    content:
        "NO PNG";

    position:
        absolute;

    font-family:
        "Courier New",
        monospace;

    font-size:
        9px;

    letter-spacing:
        1.5px;

    color:
        rgba(255,255,255,0.18);
}

.skin-preview img {
    width: 100%;
    height: 100%;

    object-fit: cover;

    position: relative;

    z-index: 2;

    display: none;

    user-select: none;
}


/* =========================================================
   SKIN INFORMATION
   ========================================================= */

.skin-information {
    display:
        flex;

    flex-direction:
        column;

    gap:
        10px;
}

.skin-label {
    font-family:
        "Courier New",
        monospace;

    font-size:
        10px;

    letter-spacing:
        1.5px;

    color:
        rgba(255,255,255,0.40);
}

.skin-description {
    font-size:
        12px;

    line-height:
        1.6;

    color:
        rgba(255,255,255,0.38);
}

.skin-button {
    width: 160px;

    height: 38px;

    border:
        1px solid rgba(255,255,255,0.15);

    background:
        rgba(255,255,255,0.04);

    color:
        rgba(255,255,255,0.75);

    font-family:
        "Courier New",
        monospace;

    font-size:
        10px;

    letter-spacing:
        1px;

    cursor:
        pointer;

    transition:
        background .2s ease,
        border-color .2s ease;
}

.skin-button:hover {
    background:
        rgba(255,255,255,0.08);

    border-color:
        rgba(255,255,255,0.25);
}

#skin-input {
    display: none;
}


/* =========================================================
   SKIN ZOOM OVERLAY
   ========================================================= */

#skin-zoom-overlay {
    position: fixed;
    inset: 0;

    z-index: 9800;

    display: flex;
    align-items: center;
    justify-content: center;

    background:
        rgba(0,0,0,0.86);

    backdrop-filter:
        blur(14px);

    opacity: 0;
    visibility: hidden;
    pointer-events: none;

    transition:
        opacity .35s ease,
        visibility .35s ease;
}

#skin-zoom-overlay.visible {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
}

.skin-zoom-window {
    width: min(760px, 90vw);
    height: min(820px, 88vh);

    display: flex;
    flex-direction: column;

    border:
        1px solid rgba(255,255,255,0.14);

    background:
        rgba(7,7,7,0.96);

    box-shadow:
        0 40px 120px rgba(0,0,0,0.80);

    transform:
        scale(.96);

    transition:
        transform .35s cubic-bezier(.2,.8,.2,1);
}

#skin-zoom-overlay.visible .skin-zoom-window {
    transform:
        scale(1);
}

.skin-zoom-header {
    height: 58px;

    display:
        flex;

    align-items:
        center;

    justify-content:
        space-between;

    padding:
        0 18px;

    border-bottom:
        1px solid rgba(255,255,255,0.09);

    flex-shrink:
        0;
}

.skin-zoom-label {
    font-family:
        "Courier New",
        monospace;

    font-size:
        9px;

    letter-spacing:
        2px;

    color:
        rgba(255,255,255,0.35);

    margin-bottom:
        5px;
}

.skin-zoom-title {
    font-size:
        15px;

    letter-spacing:
        2px;
}

.skin-zoom-close {
    width: 32px;
    height: 32px;

    border:
        1px solid rgba(255,255,255,0.10);

    background:
        transparent;

    color:
        rgba(255,255,255,0.55);

    font-size:
        19px;

    cursor:
        pointer;
}

.skin-zoom-close:hover {
    background:
        rgba(255,255,255,0.07);

    color:
        white;
}

.skin-zoom-view {
    flex: 1;
    min-height: 0;

    display:
        flex;

    align-items:
        center;

    justify-content:
        center;

    overflow:
        hidden;

    position:
        relative;

    background:
        radial-gradient(
            circle,
            rgba(255,255,255,0.035),
            rgba(0,0,0,0.65)
        );
}

#skin-zoom-image {
    max-width: 75%;
    max-height: 75%;

    object-fit: contain;

    user-select: none;

    transform-origin: center center;

    cursor:
        grab;

    transition:
        transform .12s ease;
}

#skin-zoom-image:active {
    cursor:
        grabbing;
}

.skin-zoom-controls {
    height: 62px;

    display:
        flex;

    align-items:
        center;

    justify-content:
        center;

    gap:
        8px;

    border-top:
        1px solid rgba(255,255,255,0.09);

    flex-shrink:
        0;
}

.zoom-button {
    width:
        38px;

    height:
        32px;

    border:
        1px solid rgba(255,255,255,0.12);

    background:
        rgba(255,255,255,0.035);

    color:
        rgba(255,255,255,0.70);

    font-family:
        "Courier New",
        monospace;

    font-size:
        15px;

    cursor:
        pointer;
}

.zoom-button:hover {
    background:
        rgba(255,255,255,0.08);

    color:
        white;
}

.zoom-level {
    min-width:
        62px;

    text-align:
        center;

    font-family:
        "Courier New",
        monospace;

    font-size:
        9px;

    letter-spacing:
        1px;

    color:
        rgba(255,255,255,0.45);
}


/* =========================================================
   ACTION BAR
   ========================================================= */

.action-bar {
    display:
        flex;

    align-items:
        center;

    justify-content:
        space-between;

    margin-top:
        24px;

    padding-top:
        18px;

    border-top:
        1px solid rgba(255,255,255,0.08);
}

.action-left {
    display:
        flex;

    gap:
        8px;
}

.action-button {
    height:
        39px;

    padding:
        0 16px;

    border:
        1px solid rgba(255,255,255,0.12);

    background:
        rgba(255,255,255,0.035);

    color:
        rgba(255,255,255,0.70);

    font-family:
        "Courier New",
        monospace;

    font-size:
        10px;

    letter-spacing:
        1px;

    cursor:
        pointer;

    transition:
        background .2s ease,
        border-color .2s ease;
}

.action-button:hover {
    background:
        rgba(255,255,255,0.08);

    border-color:
        rgba(255,255,255,0.22);

    color:
        white;
}

.save-button {
    background:
        rgba(255,255,255,0.09);

    color:
        white;

    border-color:
        rgba(255,255,255,0.22);
}

.save-button:hover {
    background:
        rgba(255,255,255,0.14);
}

.delete-button {
    color:
        rgba(255,120,120,0.65);
}

.save-status {
    font-family:
        "Courier New",
        monospace;

    font-size:
        9px;

    letter-spacing:
        1px;

    color:
        rgba(255,255,255,0.28);
}


/* =========================================================
   RIGHT INFORMATION PANEL
   ========================================================= */

.system-info {
    display:
        flex;

    flex-direction:
        column;

    overflow:
        hidden;
}

.info-block {
    padding:
        17px;

    border-bottom:
        1px solid rgba(255,255,255,0.08);
}

.info-title {
    font-family:
        "Courier New",
        monospace;

    font-size:
        10px;

    letter-spacing:
        2px;

    color:
        rgba(255,255,255,0.38);

    margin-bottom:
        13px;
}

.info-line {
    display:
        flex;

    justify-content:
        space-between;

