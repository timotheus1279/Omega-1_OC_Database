        absolute;

    bottom:
        14px;

    left:
        30px;

    z-index:
        30;

    font-family:
        "Courier New",
        monospace;

    font-size:
        9px;

    letter-spacing:
        1.5px;

    color:
        rgba(255,255,255,0.22);
}


/* =========================================================
   SCANLINE
   ========================================================= */

.scanline {
    position:
        absolute;

    left:
        0;

    right:
        0;

    height:
        1px;

    top:
        0;

    z-index:
        40;

    background:
        rgba(255,255,255,0.045);

    pointer-events:
        none;

    animation:
