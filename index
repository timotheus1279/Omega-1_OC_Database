/* =========================================================
   CREATE NEW DOSSIER
   ========================================================= */

async function createNewDossier() {

    let number =
        1;


    dossiers.forEach(
        dossier => {

            const match =
                String(
                    dossier.id
                )
                .match(
                    /^O1-(\d+)$/
                );


            if (
                match
            ) {

                number =
                    Math.max(
                        number,
                        parseInt(
                            match[1],
                            10
                        ) + 1
                    );

                }

        }
    );


    let newId =
        "O1-" +
        String(number).padStart(
            3,
            "0"
        );


    while (
        dossiers.some(
            dossier =>
                dossier.id ===
                newId
        )
    ) {

        number++;


        newId =
            "O1-" +
            String(number).padStart(
                3,
                "0"
            );

    }


    const newDossier =
        createEmptyDossier(
            newId
        );


    newDossier.owner =
        localUserId;


    const success =
        await saveDossierToSupabase(
            newDossier
        );


    if (
        !success
    ) {

        alert(
            "DATABASE ERROR.\n\n" +
            "The dossier could not be created."
        );

        return;

    }


    await loadDossiersFromSupabase();


    currentDossierId =
        newId;


    loadDossier();

    renderDossierList();

    updateEditorPermissions();


    setSaveStatus(
        "NEW PERSONAL DOSSIER CREATED"
    );

}


