        return;


    const search =
        searchInput
            ? searchInput.value
                .toLowerCase()
                .trim()
            : "";


    container.innerHTML =
        "";


    dossiers
        .filter(
            dossier => {

                const searchable =
                    (
                        (dossier.name || "") +
                        " " +
                        (dossier.alias || "") +
                        " " +
                        (dossier.id || "")
                    )
                    .toLowerCase();


                return searchable.includes(
                    search
                );

            }
        )
        .forEach(
            dossier => {

                const card =
                    document.createElement(
                        "div"
                    );


                const dossierStatus =
                    (
                        dossier.status ||
                        "unknown"
                    )
                    .toLowerCase();


                card.className =
                    "dossier-card status-" +
                    dossierStatus +
                    (
                        dossier.id ===
                        currentDossierId
