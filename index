/* =========================================================
   UPDATE PERMISSIONS
   ========================================================= */

function updateEditorPermissions() {

    const editable =
        canEditCurrentDossier();


    document
        .querySelectorAll(
            ".field input, .field select, .record-heading, .record-text"
        )
        .forEach(
            element => {

                element.disabled =
                    !editable;

            }
        );


    const historyEditor =
        document.getElementById(
            "history-text"
        );


    if (
        historyEditor
    ) {

        historyEditor.contentEditable =
            editable
                ? "true"
                : "false";

    }


    const toolbar =
        document.getElementById(
            "history-toolbar"
        );


    if (
        toolbar
    ) {

        toolbar
            .querySelectorAll(
                "button, select"
            )
            .forEach(
                element => {

                    element.disabled =
                        !editable;

                }
            );

    }


    const specialityButton =
        document.querySelector(
            ".speciality-button"
        );


    if (
        specialityButton
    ) {

        specialityButton.disabled =
            !editable;


        specialityButton.style.opacity =
            editable
                ? "1"
                : ".35";


        specialityButton.style.cursor =
            editable
                ? "pointer"
                : "not-allowed";

    }


    document
        .querySelectorAll(
            ".skin-button"
        )
        .forEach(
            button => {

                button.disabled =
                    !editable;


                button.style.opacity =
                    editable
                        ? "1"
                        : ".35";


                button.style.cursor =
                    editable
                        ? "pointer"
                        : "not-allowed";

            }
        );


    const newButton =
        document.querySelector(
            ".new-dossier-button"
        );


    if (
        newButton
    ) {

        newButton.disabled =
            false;


        newButton.style.opacity =
            "1";

    }


    const state =
        document.getElementById(
            "editor-state"
        );


    const permissionText =
        document.getElementById(
            "permission-text"
        );


    if (
        adminMode
    ) {

        state.classList.add(
            "unlocked"
        );


        state.innerHTML =
            '<span class="editor-dot"></span> ADMIN MODE';


        permissionText.textContent =
            "CREATOR / ADMIN";


        permissionText.style.color =
            "rgba(255,255,255,.85)";


    } else if (
        editable
    ) {

        state.classList.add(
            "unlocked"
        );


        state.innerHTML =
            '<span class="editor-dot"></span> YOUR DOSSIER';


        permissionText.textContent =
            "PERSONAL STORAGE";


        permissionText.style.color =
            "rgba(255,255,255,.75)";


    } else {

        state.classList.remove(
            "unlocked"
        );


        state.innerHTML =
            '<span class="editor-dot"></span> READ ONLY';


        permissionText.textContent =
            "READ ONLY";


        permissionText.style.color =
            "rgba(255,255,255,.42)";

    }


    const saveButton =
        document.querySelector(
            ".save-button"
        );


    if (
        saveButton
    ) {

        saveButton.disabled =
            !editable;


        saveButton.style.opacity =
            editable
                ? "1"
                : ".35";


        saveButton.style.cursor =
            editable
                ? "pointer"
                : "not-allowed";

    }


    const deleteButton =
        document.querySelector(
            ".delete-button"
        );


    if (
        deleteButton
    ) {

        deleteButton.disabled =
            !editable;


        deleteButton.style.opacity =
            editable
                ? "1"
                : ".25";


        deleteButton.style.cursor =
            editable
                ? "pointer"
                : "not-allowed";

    }


    const recordButtons =
        document.querySelectorAll(
            ".record-add"
        );


    recordButtons.forEach(
        button => {

            button.style.opacity =
                editable
                    ? "1"
                    : ".35";

        }
    );


    loadSpecialityDisabledState();

}


/* =========================================================
   SPECIALITY DISABLED STATE
   ========================================================= */

function loadSpecialityDisabledState() {

    const editable =
        canEditCurrentDossier();


    const selected =
        Array.from(
            document.querySelectorAll(
                '.speciality-option input[type="checkbox"]:checked'
            )
        );


    document
        .querySelectorAll(
            '.speciality-option input[type="checkbox"]'
        )
        .forEach(
            checkbox => {

                if (
                    !editable
                ) {

                    checkbox.disabled =
                        true;


                    checkbox.parentElement.style.opacity =
                        ".35";


                    return;

                }


                if (
                    selected.length >= 2 &&
                    !checkbox.checked
                ) {

                    checkbox.disabled =
                        true;


                    checkbox.parentElement.style.opacity =
                        ".25";

                } else {

                    checkbox.disabled =
                        false;


                    checkbox.parentElement.style.opacity =
                        "1";

                }

            }
        );

}


