/* =========================================================
   SKIN PNG UPLOAD
   ========================================================= */

function handleSkinUpload(event) {

    if (
        !canEditCurrentDossier()
    ) {

        alert(
            "READ ONLY.\n\n" +
            "You can only change the skin on your own dossier."
        );

        return;

    }


    const file =
        event.target.files[0];


    if (
        !file
    )
        return;


    if (
        file.type !==
        "image/png"
    ) {

        alert(
            "ONLY PNG FILES ARE ALLOWED."
        );


        event.target.value =
            "";


        return;

    }


    if (
        file.size >
        2 * 1024 * 1024
    ) {

        alert(
            "PNG FILE IS TOO LARGE.\n\n" +
            "Maximum size: 2 MB."
        );


        event.target.value =
            "";


        return;

    }


    const reader =
        new FileReader();


    reader.onload =
        function(e) {

            const dossier =
                getCurrentDossier();


            if (
                !dossier
            )
                return;


            const imageData =
                e.target.result;


            if (
                skinUploadTarget ===
                "back"
            ) {

                dossier.skinBack =
                    imageData;


                const image =
                    document.getElementById(
                        "skin-back-preview"
                    );


                image.src =
                    imageData;


                image.style.display =
                    "block";


                setSaveStatus(
                    "BACK PNG ATTACHED — SAVE REQUIRED"
                );

            } else {

                dossier.skinFront =
                    imageData;


                dossier.skin =
                    imageData;


                const image =
                    document.getElementById(
                        "skin-front-preview"
                    );


                image.src =
                    imageData;


                image.style.display =
                    "block";


                setSaveStatus(
                    "FRONT PNG ATTACHED — SAVE REQUIRED"
                );

            }

        };


    reader.readAsDataURL(
        file
    );

}


/* =========================================================
   HISTORY RICH TEXT
   ========================================================= */

let savedHistoryRange =
    null;


function saveHistorySelection() {

    const editor =
        document.getElementById(
            "history-text"
        );


    const selection =
        window.getSelection();


    if (
        !selection ||
        selection.rangeCount === 0
    ) {

        return;

    }


    if (
        editor &&
        editor.contains(
            selection.anchorNode
        )
    ) {

        savedHistoryRange =
            selection.getRangeAt(0);

    }

}


function restoreHistorySelection() {

    const editor =
        document.getElementById(
            "history-text"
        );


    if (
        !savedHistoryRange
    ) {

        editor.focus();

        return;

    }


    const selection =
        window.getSelection();


    selection.removeAllRanges();


    selection.addRange(
        savedHistoryRange
    );


    editor.focus();

}


