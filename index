        alert(
            "READ ONLY.\n\n" +
            "You can only edit specialities on your own dossier."
        );

        return;

    }


    const dropdown =
        document.getElementById(
            "speciality-dropdown"
        );


    const menu =
        document.getElementById(
            "speciality-menu"
        );


    dropdown.classList.toggle(
        "open"
    );


    menu.classList.toggle(
        "open"
    );

}


function updateSpecialities() {

    if (
        !canEditCurrentDossier()
    ) {

        loadDossier();

        return;

    }


    const checkboxes =
        document.querySelectorAll(
            '.speciality-option input[type="checkbox"]'
        );


    const selected =
        [];


    checkboxes.forEach(
        checkbox => {

            if (
                checkbox.checked
            ) {

                selected.push(
                    checkbox.value
                );

            }

        }
    );


    if (
        selected.length > 2
    ) {

        const last =
            selected[
                selected.length - 1
            ];


        checkboxes.forEach(
            checkbox => {

                if (
                    checkbox.value ===
                    last
                ) {

                    checkbox.checked =
                        false;

                }

            }
        );


        selected.pop();

    }


    updateSpecialityInterface(
        selected
    );


    setSaveStatus(
        "UNSAVED CHANGES"
    );

}


function updateSpecialityInterface(
    selected
) {

    const checkboxes =
        document.querySelectorAll(
            '.speciality-option input[type="checkbox"]'
        );


    checkboxes.forEach(
        checkbox => {

            if (
                selected.length >= 2 &&
                !checkbox.checked
            ) {

                checkbox.disabled =
                    true;

                checkbox.parentElement.style.opacity =
                    "0.25";

            } else {

                checkbox.disabled =
                    false;

                checkbox.parentElement.style.opacity =
                    "1";

            }

        }
    );


    const text =
        document.getElementById(
            "speciality-text"
        );


    if (
        selected.length === 0
    ) {

        text.textContent =
            "SELECT SPECIALITIES";

    } else {

        text.textContent =
            selected.join(
                " // "
            );

    }


    const tagContainer =
        document.getElementById(
            "selected-specialities"
        );


    tagContainer.innerHTML =
        "";


    selected.forEach(
        speciality => {

            const tag =
                document.createElement(
                    "div"
                );


            tag.className =
                "speciality-tag";


            tag.textContent =
                speciality.toUpperCase();


            tagContainer.appendChild(
                tag
            );

        }
    );


    loadSpecialityDisabledState();

}


/* =========================================================
   LOAD SPECIALITIES
   ========================================================= */

function loadSpecialities(
    selectedValues
) {

    const checkboxes =
        document.querySelectorAll(
            '.speciality-option input[type="checkbox"]'
        );


    checkboxes.forEach(
        checkbox => {

            checkbox.checked =
                selectedValues.includes(
                    checkbox.value
                );

        }
    );


    const selected =
        Array.from(
            checkboxes
        )
        .filter(
            checkbox =>
                checkbox.checked
        )
        .map(
            checkbox =>
                checkbox.value
        );


    updateSpecialityInterface(
        selected
    );

}


