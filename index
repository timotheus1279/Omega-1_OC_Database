    font-size:
        9px;

    line-height:
        1.8;

    letter-spacing:
        1px;

    color:
        rgba(255,255,255,0.35);
}


/* =========================================================
   NETWORK GRAPH
   ========================================================= */

.network-graph {
    height:
        38px;

    display:
        flex;

    align-items:
        flex-end;

    gap:
        3px;

    margin-top:
        15px;
}

.network-bar {
    flex:
        1;

    height:
        20%;

    background:
        rgba(255,255,255,0.35);

    animation:
        networkPulse
        1.4s
        ease-in-out
        infinite
        alternate;
}

.network-bar:nth-child(2) {
    height: 45%;
    animation-delay: .1s;
}

.network-bar:nth-child(3) {
    height: 30%;
    animation-delay: .2s;
}

.network-bar:nth-child(4) {
    height: 70%;
    animation-delay: .3s;
}

.network-bar:nth-child(5) {
    height: 52%;
    animation-delay: .4s;
}

.network-bar:nth-child(6) {
    height: 82%;
    animation-delay: .5s;
}

.network-bar:nth-child(7) {
    height: 45%;
    animation-delay: .6s;
}

.network-bar:nth-child(8) {
    height: 65%;
    animation-delay: .7s;
}

@keyframes networkPulse {

    from {
        opacity: .25;
    }

    to {
        opacity: .8;
    }

}


